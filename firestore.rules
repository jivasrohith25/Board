rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Username docs: create-once, immutable. Anyone can read for availability check.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid', 'claimedAt']);
      allow update, delete: if false;
    }

    // User profiles: only the user can read/create their own doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false; // immutable after creation
    }

    // Games: creator can read/write
    match /games/{gameId} {
      allow read: if request.auth != null
                  && resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
      allow delete: if false;

      // Rounds sub-collection
      match /rounds/{roundId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/games/$(gameId)).data.createdBy == request.auth.uid;
        allow create, update: if request.auth != null
                              && get(/databases/$(database)/documents/games/$(gameId)).data.createdBy == request.auth.uid;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/games/$(gameId)).data.createdBy == request.auth.uid;
      }
    }
  }
}